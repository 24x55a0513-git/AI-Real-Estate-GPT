# Copy to frontend/.env :   Copy-Item .env.example .env
# Vite reads this file only when `npm run dev` starts - restart it after any change.
#
# Base URL of the FastAPI backend: scheme + host + port. No trailing slash. The app adds "/api" itself
# (a value ending in /api is also accepted). If this line is missing or blank, http://localhost:8000 is used.
# Only VITE_* variables reach the browser - never put passwords or API keys here.
VITE_API_URL=http://localhost:8000
