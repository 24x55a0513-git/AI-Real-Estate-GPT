# Copy this file to backend/.env and edit it:   Copy-Item .env.example .env      (NEVER commit .env)
ENVIRONMENT=development

# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?charset=utf8mb4
# If the password contains special characters (@ : / # ? %), URL-encode them (for example @ becomes %40).
DATABASE_URL=mysql+pymysql://realestate_user:CHANGE_ME@localhost:3306/real_estate_gpt?charset=utf8mb4

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call this API (exact match, no trailing slash, comma-separated).
# In development ANY localhost / 127.0.0.1 port is also accepted automatically (Vite may pick 5174, 5175 ...),
# so this list matters mainly for production, e.g.  CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins, e.g. Vercel preview URLs:  ^https://real-estate-gpt-[a-z0-9-]+\.vercel\.app$
# Leave blank unless you need it. Never use ".*" in production (the app refuses to start with it).
CORS_ORIGIN_REGEX=

# Helper-script settings (ADMIN_EMAIL, ADMIN_PASSWORD, DEMO_USER_PASSWORD, ...) are NOT read from this file.
# Set them only for one PowerShell session when needed, e.g.  $env:ADMIN_EMAIL = "you@example.com"
